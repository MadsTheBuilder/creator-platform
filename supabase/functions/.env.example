# Server-only Edge Function configuration. Never place these in Vite variables.
TIKTOK_CLIENT_KEY=your_web_login_kit_client_key
TIKTOK_CLIENT_SECRET=your_web_login_kit_client_secret
INSTAGRAM_CLIENT_ID=your_instagram_app_id
INSTAGRAM_CLIENT_SECRET=your_instagram_app_secret
INSTAGRAM_GRAPH_VERSION=v26.0
# Optional. Otherwise existing YOUTUBE_APP_ORIGINS and YOUTUBE_TOKEN_ENCRYPTION_KEY
# are reused without rotation, with provider + creator encryption binding.
# SOCIAL_APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# SOCIAL_TOKEN_ENCRYPTION_KEY=base64_encoded_32_random_bytes
