# Creator Platform keys. Copy to `.env` (gitignored) and fill in; never commit real values.
# This file is the local master list. Deployed services don't read it: copy each key to where
# it runs (see "Goes to" on each block).

# --- Supabase (project creator-os, ref siacpdaiovnliamhorrf) ---
# Dashboard: Project Settings -> API Keys
SUPABASE_URL=https://siacpdaiovnliamhorrf.supabase.co
# Public, safe in the browser. Goes to: frontend/.env.local + Railway `site` as VITE_SUPABASE_PUBLISHABLE_KEY
SUPABASE_PUBLISHABLE_KEY=
# Full database access, server only. Goes to: Railway `worker`
SUPABASE_SECRET_KEY=

# --- LLM: Anthropic Claude ---
# console.anthropic.com -> API Keys. Goes to: Railway `worker`
ANTHROPIC_API_KEY=
# Or route through an Anthropic-compatible proxy (OpenRouter: https://openrouter.ai/api): set these two instead of the key above.
# CLAUDE_MODEL overrides the model name if the proxy uses a different one. Goes to: Railway `worker`
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
CLAUDE_MODEL=

# --- Higgsfield (3D previs + video generation, modules 5-6) ---
# Not wired in yet: API vs MCP is still an open decision (CLAUDE.md). Names follow Higgsfield's
# API key + secret pair; confirm against their docs when we integrate.
HF_API_KEY=
HF_API_SECRET=

# --- treg (module 2 Radar: Google News via Serper, $0.001 a call) ---
# Server only (Railway worker). treg.to -> API token. worker/radar.ts stops a run at its spending cap.
TREG_API_KEY=

# --- SerpApi (Google search / Trends for module 2) ---
# serpapi.com -> Dashboard -> API Key. Server only. Radar uses it for Google Trends (free plan: 250 searches/month).
SERPAPI_API_KEY=

# YouTube Data API key (server only): Radar's searches and channel stats. console.cloud.google.com -> APIs -> YouTube Data API v3.
YOUTUBE_DATA_API_KEY=

# --- Guest account (the #guest link; see worker/guest.ts) ---
# Email of the shared guest user; `node guest.ts reset` creates it. Unset turns the link off. Goes to: Railway `worker`
GUEST_EMAIL=
# Whose projects, plan, Radar and styles the reset copies into the guest (a Supabase user id). Goes to: Railway `worker`
GUEST_SOURCE_USER=
